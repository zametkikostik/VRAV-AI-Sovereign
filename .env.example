# Copy to .env and fill values — never commit real secrets

# App
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Auth: off | optional | required
AUTH_MODE=optional
# AUTH_BOOTSTRAP_ADMIN_KEY=change-me-long-random

# Ollama (local sovereign models)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3.1
BGGPT_MODEL=bggpt

# OpenRouter (optional commercial open-weight)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.1-70b-instruct

# Fact-check / search (optional)
SERPER_API_KEY=
TAVILY_API_KEY=

# Security
ENABLE_PROMPT_INJECTION_SHIELD=true
ENABLE_CODE_SAFETY_FILTER=true
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LOG_ENCRYPTION_KEY=
MAX_PROMPT_LENGTH=32000
LOG_LEVEL=INFO
ENCRYPTED_LOG_PATH=logs/secure_events.log
