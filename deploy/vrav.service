[Unit]
Description=VRAV AI Sovereign Orchestrator
After=network.target

[Service]
Type=simple
User=vrav
Group=vrav
WorkingDirectory=/opt/vrav
EnvironmentFile=/opt/vrav/.env
ExecStart=/opt/vrav/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2 --proxy-headers
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/vrav/data /opt/vrav/logs

[Install]
WantedBy=multi-user.target
